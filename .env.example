# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENROUTER_API_KEY=
# Modelo del centro de capacitación. Si se deja vacío se usa el defecto del
# código (DEFAULT_AI_MODEL en src/lib/ai-model.ts).
TRAINING_AI_MODEL=google/gemini-3.6-flash
# Tope de tiempo de UNA llamada de análisis de documento, en milisegundos.
# Opcional: si se deja vacío o no es un entero positivo se usa el defecto
# (20000). Súbelo si los resúmenes salen marcados como parciales de forma
# sistemática: los modelos 3.x razonan por defecto y tardan más. El techo real
# lo sigue poniendo el presupuesto total del análisis (35 s).
TRAINING_ANALYSIS_CALL_TIMEOUT_MS=
# Caracteres de documentos que caben en la generación de módulos.
# Opcional: si se deja vacío o no es un entero positivo se usa el defecto
# (300000), dimensionado en src/lib/training/document-context.ts. Súbelo solo si
# el modelo de TRAINING_AI_MODEL tiene ventana para más.
TRAINING_CONTEXT_CHAR_BUDGET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email
BREVO_API_KEY=
RESEND_API_KEY=

# Storage (Cloudflare R2 opcional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Analytics (opcional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
