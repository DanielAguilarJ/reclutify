# ═══════════════════════════════════════════════════════════════════════════════
# Reclutify — variables de entorno
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copia este archivo a `.env.local` y rellena los valores.
#
# CÓMO LEER ESTE ARCHIVO
# ──────────────────────
#   [OBLIGATORIA]  la aplicación no arranca o la función se rompe sin ella.
#   [OPCIONAL]     si falta, esa función se desactiva de forma controlada.
#   [DERIVADA]     la inyecta la plataforma de despliegue; no la pongas a mano.
#
# `NEXT_PUBLIC_*` se INCRUSTA EN EL BUNDLE DEL NAVEGADOR. Cualquier valor con
# ese prefijo es público por definición: nunca pongas un secreto ahí.
#
# Este archivo estaba incompleto: le faltaban las ocho variables de Stripe, el
# secreto del webhook de Make, las voces del sintetizador y la verificación de
# Google. Una variable ausente de aquí es una variable que nadie configura en un
# despliegue nuevo, y el fallo aparece en producción, no al arrancar.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Supabase ─────────────────────────────────────────────────────────────────

# [OBLIGATORIA] URL del proyecto. Panel > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# [OBLIGATORIA] Clave publicable (`anon`). Viaja al navegador: es pública y está
# bien que lo sea. Toda la protección de los datos que alcanza depende de las
# políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [OBLIGATORIA] Clave de servicio (fila `service_role` del panel).
#
# SALTA RLS POR COMPLETO. Solo se usa en el servidor y cada endpoint que la usa
# tiene que validar identidad, organización y permisos por su cuenta. Nunca la
# expongas con prefijo NEXT_PUBLIC_.
#
# `src/lib/supabase-key.ts` comprueba la FORMA del valor al arrancar el cliente:
# si aquí pegas el nombre de la fila, o la clave `anon` por error, obtendrás un
# mensaje explícito en vez de un `401 Invalid API key` por operación.
SUPABASE_SERVICE_ROLE_KEY=


# ─── IA (OpenRouter) ──────────────────────────────────────────────────────────

# [OBLIGATORIA] Clave de OpenRouter. La usan la entrevista (`/api/chat`), la
# evaluación, la síntesis de voz, la generación de rúbricas, el parseo de CV y el
# centro de capacitación.
#
# Todos esos endpoints tienen tope de tasa (ver RATE_LIMIT_SALT más abajo). Sin
# él, un bucle de peticiones agota el saldo de la cuenta.
OPENROUTER_API_KEY=

# [OPCIONAL] Sustitución del modelo por función. Si se deja vacía se usa el
# defecto que fija `src/lib/ai-model.ts`. Permite revertir un cambio de modelo
# sin desplegar código.
#
# La cadena VACÍA cuenta como ausencia: `MODELO=` no envía `"model": ""` a
# OpenRouter (que devolvería 400), usa el defecto.
INTERVIEW_CHAT_MODEL=
INTERVIEW_EVALUATION_MODEL=
SENTIMENT_MODEL=
CONTENT_GENERATION_MODEL=
TTS_MODEL=

# [OPCIONAL] Voces del sintetizador, por idioma.
#
# Solo ocho modelos de OpenRouter admiten el endpoint `/audio/speech`, y las
# voces tienen que pertenecer al modelo de TTS_MODEL. Defectos:
#   es → es-MX-Valeria:MAI-Voice-2
#   en → en-US-Harper:MAI-Voice-2
#
# Llevan prefijo NEXT_PUBLIC_ por compatibilidad con los despliegues existentes,
# aunque su único consumidor sea el servidor. No son secretos.
NEXT_PUBLIC_VOICE_ES=
NEXT_PUBLIC_VOICE_EN=


# ─── Centro de capacitación ───────────────────────────────────────────────────

# [OPCIONAL] Modelo del centro de capacitación. Vacía → DEFAULT_AI_MODEL.
TRAINING_AI_MODEL=google/gemini-3.6-flash

# [OPCIONAL] Tope de tiempo de UNA llamada de análisis de documento, en ms.
# Vacía o no entera positiva → 20000. Súbelo si los resúmenes salen marcados como
# parciales de forma sistemática: los modelos 3.x razonan por defecto y tardan
# más. El techo real lo sigue poniendo el presupuesto total del análisis (35 s).
TRAINING_ANALYSIS_CALL_TIMEOUT_MS=

# [OPCIONAL] Caracteres de documento que caben en UNA llamada de análisis.
# Vacía → el defecto de `src/lib/training/document-analysis.ts`.
TRAINING_ANALYSIS_CHAR_BUDGET=

# [OPCIONAL] Caracteres de documentos que caben en la generación de módulos.
# Vacía → 300000, dimensionado en `src/lib/training/document-context.ts`. Súbelo
# solo si el modelo de TRAINING_AI_MODEL tiene ventana para más.
TRAINING_CONTEXT_CHAR_BUDGET=


# ─── Aplicación ───────────────────────────────────────────────────────────────

# [OBLIGATORIA EN PRODUCCIÓN] URL pública absoluta, con esquema y sin barra final.
#
# NO se deriva de las cabeceras de la petición a propósito: los enlaces de
# capacitación y de entrevista llevan un token de acceso embebido, y un
# `Host: atacante.example` falsificado produciría un enlace apuntando al atacante
# firmado por nosotros. El razonamiento completo está en `src/lib/app-url.ts`.
#
# Fuera de producción, si falta, se cae a http://localhost:$PORT.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPCIONAL] Sal del hash de los identificadores del limitador de tasa.
#
# La tabla `api_rate_limits` no guarda IPs en claro: guarda un SHA-256 con sal.
# Sin sal, el espacio IPv4 (2^32) es invertible por fuerza bruta en minutos.
#
# Si se deja vacía se usa SUPABASE_SERVICE_ROLE_KEY, que ya es un secreto del
# servidor con la entropía necesaria. Rotarla solo reinicia los contadores en
# vuelo, que es inocuo.
RATE_LIMIT_SALT=

# [OPCIONAL] Código de verificación de Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ─── Correo ───────────────────────────────────────────────────────────────────

# [OPCIONAL] Brevo, para las invitaciones a entrevista (`/api/send-email`). Sin
# ella el endpoint devuelve 500 y el reclutador no puede invitar por correo.
BREVO_API_KEY=

# [OPCIONAL] Resend, para los avisos al reclutador al terminar una entrevista.
# Sin ella el aviso se omite y la evaluación se guarda igual.
RESEND_API_KEY=


# ─── Almacenamiento de vídeo (Cloudflare R2) ──────────────────────────────────
#
# [OPCIONAL EN CONJUNTO] Las cinco se necesitan juntas: sin una sola,
# `/api/upload-video` devuelve un error de configuración explícito y la grabación
# se queda en el navegador (solo durante esa pestaña).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# URL pública del bucket, absoluta y con esquema. Se usa para construir el enlace
# permanente de la grabación y se añade a `connect-src` y `media-src` de la CSP,
# así que un valor mal formado deja el vídeo bloqueado por la política.
R2_PUBLIC_URL=


# ─── Stripe (facturación) ─────────────────────────────────────────────────────
#
# [OPCIONAL EN CONJUNTO] Sin estas variables las rutas de pago fallan, pero el
# resto del producto funciona: `getOrgPlan` cae al plan `starter`.

# Clave secreta. `sk_test_...` en desarrollo.
STRIPE_SECRET_KEY=

# Secreto de firma del endpoint de webhook (`whsec_...`). Es lo ÚNICO que
# autentica `/api/stripe/webhooks`: esa ruta se salta el middleware a propósito
# porque llega sin sesión.
STRIPE_WEBHOOK_SECRET=

# Identificadores de precio (`price_...`) de los tres planes en sus dos periodos.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=


# ─── Integraciones salientes ──────────────────────────────────────────────────

# [OPCIONAL] Secreto compartido con el webhook de Make/Integromat.
MAKE_WEBHOOK_SECRET=


# ─── Analítica ────────────────────────────────────────────────────────────────

# [OPCIONAL] PostHog. Sin la clave, el proveedor no se inicializa y no se envía
# nada. El host se añade a `script-src` y `connect-src` de la CSP.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ─── Inyectadas por la plataforma ─────────────────────────────────────────────
#
# [DERIVADAS] No las pongas a mano. `src/lib/app-url.ts` las usa como respaldo de
# NEXT_PUBLIC_APP_URL, en este orden de precedencia:
#
#   1. NEXT_PUBLIC_APP_URL                 (configuración explícita, gana siempre)
#   2. VERCEL_PROJECT_PRODUCTION_URL       (dominio estable de producción)
#   3. VERCEL_URL                          (host del despliegue actual; cambia en
#                                           cada despliegue, sirve para vistas
#                                           previa)
#   4. http://localhost:$PORT              (solo fuera de producción)
#
# VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_URL=
# PORT=3000
